<Window x:Class="TicketLog.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calculadora Ticket Log"
        Icon="logo.ico"
        Width="500"
        MinWidth="440"
        Height="760"
        MinHeight="680"
        Background="#090909"
        Foreground="#F7F3F3"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F7F3F3"/>
            <Setter Property="Background" Value="#0D0B0B"/>
            <Setter Property="BorderBrush" Value="#493236"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#7F2029"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#E32636"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#B5A9AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="460" Margin="28,25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="68"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="logo-ui.png" Width="68" Height="68" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="CALCULADORA" Foreground="#FF4655" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Ticket Log" FontSize="21" FontWeight="Bold"/>
                    <TextBlock Text="Abastecimento sem ultrapassar o valor" Foreground="#B5A9AA" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Padding="20" CornerRadius="20" BorderBrush="#3B171A" BorderThickness="1" Background="#151111">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,17">
                        <Ellipse Width="8" Height="8" Fill="#E32636" VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Dados do abastecimento" FontSize="15" FontWeight="Bold"/>
                    </StackPanel>

                    <Label Content="Valor máximo que o cliente vai pagar" Target="{Binding ElementName=ValorMaximo}"/>
                    <Grid>
                        <TextBlock Text="R$" Foreground="#D6CACC" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" Panel.ZIndex="1" IsHitTestVisible="False"/>
                        <TextBox x:Name="ValorMaximo" Text="90,00" Padding="43,0,14,0"/>
                    </Grid>

                    <Label Content="Preço por litro considerado no Ticket Log" Margin="0,15,0,6" Target="{Binding ElementName=PrecoTicket}"/>
                    <Grid>
                        <TextBlock Text="R$" Foreground="#D6CACC" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0" Panel.ZIndex="1" IsHitTestVisible="False"/>
                        <TextBox x:Name="PrecoTicket" Text="7,10" Padding="43,0,14,0"/>
                    </Grid>

                    <TextBlock Text="Os litros são calculados pelo preço do Ticket Log. O preço da bomba não entra nessa conta."
                               Foreground="#A99D9F" FontSize="11" TextWrapping="Wrap" Margin="1,9,1,0"/>

                    <Border Margin="0,19,0,0" Padding="17" CornerRadius="17" BorderBrush="#7F2029" BorderThickness="1" Background="#291012">
                        <StackPanel>
                            <TextBlock Text="PASSE ESTES VALORES NA BOMBA" Foreground="#FF9BA2" FontSize="10" FontWeight="Bold" Margin="0,0,0,13"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Padding="12,13" Margin="0,0,5,0" CornerRadius="13" BorderBrush="#592027" Background="#0B0809">
                                    <StackPanel>
                                        <TextBlock Text="LITROS" Foreground="#C5AEB0" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="Litros" Text="12 L" FontSize="24" FontWeight="ExtraBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Padding="12,13" Margin="5,0,0,0" CornerRadius="13" BorderBrush="#592027" Background="#0B0809">
                                    <StackPanel>
                                        <TextBlock Text="REAIS" Foreground="#C5AEB0" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="Reais" Text="R$ 4,80" FontSize="24" FontWeight="ExtraBold" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Valor dos litros no Ticket Log" Foreground="#C4B7B8" FontSize="12"/>
                                <TextBlock x:Name="ValorLitros" Grid.Column="1" Text="R$ 85,20" Foreground="#F7F3F3" FontSize="13" FontWeight="SemiBold"/>
                            </Grid>
                            <Border BorderBrush="#A93640" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,13,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Total calculado" Foreground="#C4B7B8" FontSize="13"/>
                                    <TextBlock x:Name="TotalCalculado" Grid.Column="1" Text="R$ 90,00" Foreground="#FF737D" FontSize="17" FontWeight="Bold"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="Status" Text="Valor exato, sem ultrapassar o limite." Foreground="#FFAFB4" FontSize="11" FontWeight="Bold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" TextAlignment="Center" TextWrapping="Wrap" Foreground="#A99D9F" FontSize="11" Margin="3,22,3,0">
                Desenvolvido por <Run Text="Eldritch Tenebris" Foreground="#FF737D" FontWeight="Bold"/> · Programador Pleno
            </TextBlock>
        </Grid>
    </ScrollViewer>
</Window>
